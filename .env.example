# Frontend: populated by local Convex setup or your cloud project.
NEXT_PUBLIC_CONVEX_URL=
# CREAO credentials belong in Convex, not NEXT_PUBLIC variables.
# Paste into .env.integrations.local, then run npm run configure:integrations.
# capi_ key from agent.creao.ai; agent must have one text input named prompt.
CREAO_API_KEY=
# Saved Agent ID from its page (sent to v1 as appId).
CREAO_AGENT_ID=

# Separate saved Policy Learner; missing configuration disables live learning only.
CREAO_POLICY_AGENT_ID=
# Optional when the existing key is authorized for both agents.
CREAO_POLICY_API_KEY=

# Optional Moss retrieval; both required. Apply server-side with configure:integrations.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
