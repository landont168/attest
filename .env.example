# Frontend: populated by local Convex setup or your cloud project.
NEXT_PUBLIC_CONVEX_URL=
# CREAO credentials belong in Convex, not NEXT_PUBLIC variables.
# Paste into .env.integrations.local, then run npm run configure:integrations.
# capi_ key from agent.creao.ai; agent must have one text input named prompt.
CREAO_API_KEY=
# Saved Agent ID from its page (sent to v1 as appId).
CREAO_AGENT_ID=
